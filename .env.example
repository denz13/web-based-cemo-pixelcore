# Google Cloud Vision — server only (never NEXT_PUBLIC_*).
# Copy this file to `.env.local` in the project root, set one of the keys below,
# then stop and restart `npm run dev` (env is read at server start).
GOOGLE_CLOUD_VISION_API_KEY=
# Optional alias (same value) if you prefer a shorter name:
# GOOGLE_VISION_API_KEY=

# Optional: Google Knowledge Graph — only if you want an extra lookup before Wikidata.
# Without this key, taxon resolution uses Wikidata then iNaturalist (no extra signup).
# https://developers.google.com/knowledge-graph
# GOOGLE_KNOWLEDGE_GRAPH_API_KEY=
